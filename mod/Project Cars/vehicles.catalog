# Frame and part IDs are mod-owned. Quoted building bindings are exact FCS IDs.
# No dependency on unfinished meshes or the future frame-kit item.
catalog 1
# part ID KIND FUEL CAPACITY_LITRES BURN_LITRES_PER_SIM_SECOND
part small_gas_engine engine gasoline 0 0.002
part small_diesel_engine engine diesel 0 0.0015
part road_wheel wheel none 0 0
part offroad_wheel wheel none 0 0
part tank_40 tank none 40 0
part tank_80 tank none 80 0
part light_armor upgrade none 0 0
part heavy_armor upgrade none 0 0
part headlights upgrade none 0 0
part cargo_rack upgrade none 0 0
part basic_seat seat none 0 0
# First user-authored Small Frame: one seat mount; seat starts uninstalled.
# Component fit and performance remain provisional until the parts are bound.
frame small_frame 30 20 1 20 4 0.8
slot small_frame seat_driver basic_seat
building small_frame "10-Project Cars.mod"
slot small_frame engine small_gas_engine,small_diesel_engine
slot small_frame tank tank_40
slot small_frame wheel_fl road_wheel,offroad_wheel
slot small_frame wheel_fr road_wheel,offroad_wheel
slot small_frame wheel_rl road_wheel,offroad_wheel
slot small_frame wheel_rr road_wheel,offroad_wheel
slot small_frame armor light_armor
slot small_frame headlights headlights

# frame ID BUILD_WORK DISASSEMBLY_WORK SEATS MAX_MPS ACCEL_MPS2 TURN_RAD_S
# Work units and driving numbers are provisional tuning, not FCS build time.
frame scout 30 20 2 20 4 0.8
slot scout seat_driver basic_seat
slot scout seat_passenger_1 basic_seat
slot scout engine small_gas_engine,small_diesel_engine
slot scout tank tank_40
slot scout wheel_fl road_wheel,offroad_wheel
slot scout wheel_fr road_wheel,offroad_wheel
slot scout wheel_rl road_wheel,offroad_wheel
slot scout wheel_rr road_wheel,offroad_wheel
slot scout armor light_armor
slot scout headlights headlights

frame hauler 60 40 4 14 2 0.5
slot hauler seat_driver basic_seat
slot hauler seat_passenger_1 basic_seat
slot hauler seat_passenger_2 basic_seat
slot hauler seat_passenger_3 basic_seat
slot hauler engine small_diesel_engine
slot hauler tank tank_40,tank_80
slot hauler wheel_fl offroad_wheel
slot hauler wheel_fr offroad_wheel
slot hauler wheel_rl offroad_wheel
slot hauler wheel_rr offroad_wheel
slot hauler armor light_armor,heavy_armor
slot hauler headlights headlights
slot hauler cargo cargo_rack
